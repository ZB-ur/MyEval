  "configurations": [
    {
      "id": "sidelit-author-schema-v1",
      "name": "作者基线",
      "version": "1.0.0",
      "mode": "fixed_context_rerun",
      "parameters": {
        "profile_id": "author-schema-v1"
      },
      "intent_aware": false,
      "hypothesis": "保留当前作者 schema 和默认参数。"
    },
    {
      "id": "sidelit-evidence-grounded-v1",
      "name": "A · 证据约束",
      "version": "1.1.0",
      "mode": "fixed_context_rerun",
      "parameters": {
        "profile_id": "evidence-grounded-v1"
      },
      "intent_aware": false,
      "hypothesis": "减少无依据的事实与技术因果，保留具体建议。"
    },
    {
      "id": "sidelit-intent-conditioned-v1",
      "name": "B · 意图条件",
      "version": "1.1.0",
      "mode": "fixed_context_rerun",
      "parameters": {
        "profile_id": "intent-conditioned-v1"
      },
      "intent_aware": true,
      "hypothesis": "在相同证据约束下使建议符合用户意图。"
    }
  ]
}
