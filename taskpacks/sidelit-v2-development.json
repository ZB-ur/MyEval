{
  "id": "sidelit-v2-development",
  "project": "sidelit",
  "name": "Sidelit · 公开照片开发对照",
  "version": "1.1.0",
  "description": "3 个已见公开来源 × 作者基线/证据约束/意图条件；真实共用 Mac native 模型路径，无真机或摄影偏好收益声明。",
  "rubric": [
    {
      "id": "visible_facts",
      "name": "可见事实准确",
      "description": "主体、物体、位置和关系与实际图片一致。"
    },
    {
      "id": "technical_grounding",
      "name": "技术诊断依据",
      "description": "区分可见现象和未知拍摄参数、原因。"
    },
    {
      "id": "intent_fit",
      "name": "意图适切",
      "description": "建议支持显式意图，并保留必要主体/环境信息。"
    },
    {
      "id": "actionability",
      "name": "建议可执行",
      "description": "建议具体、有图片依据，可由用户决定采取。"
    },
    {
      "id": "opinion_boundary",
      "name": "审美意见边界",
      "description": "审美偏好作为可选判断，不伪装客观事实。"
    },
    {
      "id": "usefulness",
      "name": "非空泛与非回避",
      "description": "既不编造也给出有信息量的观察或建议。"
    }
  ],
  "rubric_ref": "rubrics/sidelit-v2.json",
  "cases": [
