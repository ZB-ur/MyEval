{
  "id": "pome-text-foundation",
  "project": "pome",
  "name": "鸭鸭日记 · 多轮与忠实整理",
  "version": "1.0.0",
  "description": "两个明确虚构的独立 episode。通过真实产品 HTTP 草稿、候选、审校、交付与整理路径。只比较文字能力，不代表儿童质量或声音验收。",
  "rubric": [
    {
      "id": "faithfulness",
      "name": "忠实原话与纠正",
      "description": "是否保留明确观察、动作、不确定和后续纠正，未增编次数、位置、心理、动机或标签。"
    },
    {
      "id": "dialogue",
      "name": "接话与鼓励",
      "description": "是否回应本轮变化并给贴合内容的接纳，避免机械复述；危险动作不表扬。"
    },
    {
      "id": "turn_boundary",
      "name": "轮次与追问边界",
      "description": "不额外增加轮次；首轮、末轮、主动结束不追问，不把不知道误判为结束。"
    },
    {
      "id": "background",
      "name": "背景使用",
      "description": "只用允许的同幼儿历史帮助理解；不得把背景、其他幼儿或未来事实写入本次。"
    },
    {
      "id": "summary",
      "name": "整理与原话分离",
      "description": "整理仅依据儿童原话；AI猜测和鼓励不作为事实，原始对话独立保留。"
    }
  ],
