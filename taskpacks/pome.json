{
  "id": "pome-text-foundation",
  "project": "pome",
  "name": "鸭鸭日记 · 多轮与忠实整理",
  "version": "1.3.0",
  "description": "保留四个基础 episode 与四个既有配置，新增六个教师反馈评阅场景和两种具体回应配置。全部为冻结虚构材料，历史由真实产品初始状态选择；比较关键回应、有据鼓励、相关背景、简洁自然与事实忠实，不合成总分，不代表真实儿童质量或声音验收。 1.3.0 新增相关历史方案关闭思考的配置，案例与已有配置不变。",
  "rubric": [
    {
      "id": "responsive",
      "name": "回应关键意思",
      "description": "是否接住本轮关键意思、变化或纠正，让回应随新增内容更新；机械复读整句或只说通用赞语不等于理解。"
    },
    {
      "id": "encouragement",
      "name": "有据的鼓励",
      "description": "鼓励或接纳是否对应本次明确的观察、行动、求助、纠正或表达；可肯定有依据的关心，不编造善意、不下稳定人格结论、不表扬危险动作。"
    },
    {
      "id": "context_use",
      "name": "历史与档案运用",
      "description": "相关且可靠时才自然联系同幼儿历史，准确使用动物名字与类型；不联系无关历史也可恰当，不套用未核对内容，不使用其他幼儿、未来记录、教师备注或展示颜色推断事实。"
    },
    {
      "id": "concise",
      "name": "简洁自然",
      "description": "抓住必要细节、转折和否定，以自然亲切的语言接话；避免全句复读、空泛夸奖、固定套路和冗长解释，不把越短越好当作标准。"
    },
    {
      "id": "faithfulness",
      "name": "忠实原话与纠正",
      "description": "分别核对接话与整理是否忠实于儿童原话、后续纠正和不确定；不补编动作、动机、心理、独立性或稳定人格，整理不混入历史、档案备注和AI发言。"
    },
    {
      "id": "dialogue",
      "name": "接话与鼓励",
      "description": "是否回应本轮变化并给贴合内容的接纳，避免机械复述；危险动作不表扬。"
    },
    {
      "id": "turn_boundary",
      "name": "轮次与追问边界",
      "description": "不额外增加轮次；首轮、末轮、主动结束不追问；区分不知道、否定结束、第三方结束引语与儿童本人的结束意愿。"
    },
    {
      "id": "background",
      "name": "背景使用",
      "description": "只用允许的同幼儿历史帮助理解；不得把背景、其他幼儿或未来事实写入本次。"
    },
    {
      "id": "summary",
      "name": "整理与原话分离",
      "description": "整理仅依据儿童原话；AI猜测和鼓励不作为事实，原始对话独立保留。"
    }
  ],
