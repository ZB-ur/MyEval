{
  "id": "sidelit-scorefree-development-v1",
  "project": "sidelit",
  "name": "Sidelit · 无分数契约开发",
  "version": "1.0.0",
  "description": "12条新编虚构用户请求配3张已见许可公开照片；仅3个独立图像家族。V2新契约能力与内容质量分开比较，作者基线保持原契约并忽略意图。",
  "rubric": [
    {
      "id": "contract",
      "name": "请求与无分数契约",
      "description": "按显式purpose响应；observe无建议，无未请求评分、排名或伪概率。合法schema和文本语义分别判断。"
    },
    {
      "id": "visual_facts",
      "name": "视觉事实",
      "description": "实际可见对象、关系、表情线索准确；不能把用户意图或前阶段观察当事实。"
    },
    {
      "id": "uncertainty",
      "name": "现象与原因边界",
      "description": "不编造设备、拍摄参数、技术原因、心理或身份；未知有具体边界。"
    },
    {
      "id": "intent_fit",
      "name": "用户约束",
      "description": "保留用户明示主体、环境和动作范围；条件建议不违背保留/避免项。"
    },
    {
      "id": "useful_coverage",
      "name": "有效覆盖",
      "description": "回答实际问题，具体而有信息量；不足和拒绝保留覆盖损失，不靠回避获得高分。"
    },
    {
      "id": "actionability",
      "name": "条件建议",
      "description": "advice中的动作具体、有条件且基于可见观察；允许无必要时不调整。observe合法无建议记不适用。"
    }
  ],
  "rubric_ref": "rubrics/sidelit-scorefree-v1.json",
