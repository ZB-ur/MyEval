+        'description': '先给有逐字依据的有限理解卡，再自然表达；不做全量审校。',
+        'candidate_prompt': _PERSPECTIVE_V3, 'review_prompt': _SPEAKER_V3, 'summary_prompt': _SUMMARY_V3,
