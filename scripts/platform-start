#!/usr/bin/env python3
"""Start MyEval's isolated local Langfuse stack; never print generated secrets."""
import json
import base64
import os
from pathlib import Path
import platform
import secrets
import shutil
import subprocess
import sys
import time
from urllib.request import ProxyHandler, Request, build_opener

ROOT = Path(__file__).resolve().parents[1]
LOCAL = ROOT / '.local' / 'platform'
LOCAL.mkdir(parents=True, exist_ok=True, mode=0o700)
os.chmod(LOCAL, 0o700)
env = os.environ.copy()
env['DOCKER_CONFIG'] = str(LOCAL / 'docker')
env['COLIMA_HOME'] = str(LOCAL / 'colima')
env['LIMA_HOME'] = str(LOCAL / 'colima' / '_lima')
for key in ('DOCKER_CONTEXT', 'DOCKER_TLS_VERIFY', 'DOCKER_CERT_PATH'):
    env.pop(key, None)
Path(env['DOCKER_CONFIG']).mkdir(exist_ok=True)
Path(env['COLIMA_HOME']).mkdir(exist_ok=True)
Path(env['DOCKER_CONFIG'], 'config.json').write_text(json.dumps({'cliPluginsExtraDirs': ['/opt/homebrew/lib/docker/cli-plugins', '/usr/local/lib/docker/cli-plugins']}))

secrets_path = LOCAL / 'secrets.env'
if not secrets_path.exists():
    values = {key: secrets.token_hex(32) for key in ('POSTGRES_PASSWORD', 'CLICKHOUSE_PASSWORD', 'MINIO_ROOT_PASSWORD', 'REDIS_AUTH', 'SALT', 'ENCRYPTION_KEY', 'NEXTAUTH_SECRET', 'LANGFUSE_USER_PASSWORD')}
    values.update(LANGFUSE_PUBLIC_KEY='pk-lf-' + secrets.token_hex(16), LANGFUSE_SECRET_KEY='sk-lf-' + secrets.token_hex(32))
    with os.fdopen(os.open(secrets_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), 'w') as file:
        file.write(''.join(f'{key}={value}\n' for key, value in values.items()))
else:
    values = dict(line.split('=', 1) for line in secrets_path.read_text().splitlines() if '=' in line and not line.startswith('#'))
os.chmod(secrets_path, 0o600)
env.update(values)
client_path = LOCAL / 'client.json'
with os.fdopen(os.open(client_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), 'w') as file:
    json.dump({'base_url': 'http://127.0.0.1:3300', 'project_id': 'myeval', 'public_key': values['LANGFUSE_PUBLIC_KEY'], 'secret_key': values['LANGFUSE_SECRET_KEY']}, file, indent=2)

def run(command, name, timeout):
    print(name, flush=True)
    with (LOCAL / (name + '.log')).open('a') as file:
        try:
            proc = subprocess.run(command, env=env, stdout=file, stderr=subprocess.STDOUT, timeout=timeout)
        except subprocess.TimeoutExpired:
            print(f'{name} timed out; see {file.name}', file=sys.stderr)
            raise SystemExit(1)
    if proc.returncode:
        print(f'{name} failed; see {LOCAL / (name + ".log")}', file=sys.stderr)
        raise SystemExit(proc.returncode)

if platform.system() == 'Darwin':
    if not shutil.which('colima') or not shutil.which('docker'):
        raise SystemExit('Install official Homebrew packages: brew install colima docker docker-compose')
    run(['colima', 'start', 'myeval', '--cpus', '4', '--memory', '8', '--disk', '20', '--root-disk', '8', '--vm-type', 'vz', '--mount', 'none', '--activate=false', '--ssh-config=false'], 'colima-start', 420)
    env['DOCKER_HOST'] = 'unix://' + str(LOCAL / 'colima' / 'myeval' / 'docker.sock')
elif not shutil.which('docker'):
    raise SystemExit('Docker with Compose is required.')

compose = ['docker', 'compose', '--env-file', str(secrets_path), '-f', str(ROOT / 'infra' / 'compose.yaml')]
run(compose + ['up', '-d'], 'compose-start', 900)
deadline = time.monotonic() + 180
while time.monotonic() < deadline:
    try:
        with build_opener(ProxyHandler({})).open('http://127.0.0.1:3300/api/public/health', timeout=5) as response:
            if response.status == 200 and json.load(response).get('version') == '4.76.0':
                auth = base64.b64encode((values['LANGFUSE_PUBLIC_KEY'] + ':' + values['LANGFUSE_SECRET_KEY']).encode()).decode()
                request = Request('http://127.0.0.1:3300/api/public/projects', headers={'Authorization': 'Basic ' + auth})
                with build_opener(ProxyHandler({})).open(request, timeout=5) as check:
                    if not any(project.get('id') == 'myeval' for project in json.load(check).get('data', [])):
                        continue
                print('Langfuse ready: http://127.0.0.1:3300')
                print('Local credentials: .local/platform/secrets.env (LANGFUSE_USER_PASSWORD); email local@myeval.invalid')
                raise SystemExit(0)
    except (OSError, ValueError):
        pass
    time.sleep(3)
raise SystemExit('Containers started, but Langfuse health did not become ready. Inspect scripts/platform-status and .local/platform logs.')
