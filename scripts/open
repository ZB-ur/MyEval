#!/usr/bin/env python3
"""Open this local installation without printing its administrator capability."""
import argparse
import json
from pathlib import Path
import webbrowser

parser = argparse.ArgumentParser(description='打开指定本机工作区，不输出管理员访问码。')
parser.add_argument('--data-dir', type=Path, default=Path(__file__).resolve().parents[1] / '.local/data')
args = parser.parse_args()
directory = args.data_dir.resolve()
try:
    state = json.loads((directory / 'server.json').read_text())
    token = (directory / 'admin.token').read_text().strip()
except (OSError, ValueError):
    parser.exit(1, '该工作区尚未就绪，请先用相同 --data-dir 启动服务。\n')
webbrowser.open(state['url'].rstrip('/') + '/#access=' + token)
