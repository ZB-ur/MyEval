#!/usr/bin/env python3
"""Open this local installation without printing its administrator capability."""
import json
from pathlib import Path
import webbrowser

directory = Path(__file__).resolve().parents[1] / '.local/data'
state = json.loads((directory / 'server.json').read_text())
token = (directory / 'admin.token').read_text().strip()
webbrowser.open(state['url'] + '/#access=' + token)
